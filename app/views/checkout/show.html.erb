<div class="checkout-box">
  <h1 class="page-title">Checkout</h1>

  <% if @needs_address %>
    <div class="step-header">
      <h3>Step 1: Shipping Address</h3>
      <p>Enter your details to calculate regional taxes.</p>
    </div>

    <%= form_with model: current_user, url: update_address_checkout_path, method: :patch do |f| %>
      <div class="form-group">
        <%= f.label :address, "Street Address" %>
        <%= f.text_field :address, required: true, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= f.label :city, "City" %>
        <%= f.text_field :city, required: true, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= f.label :province_id, "Province" %>
        <%= f.collection_select :province_id, Province.all, :id, :name, { prompt: "Select Province" }, { required: true, class: "form-input" } %>
      </div>

      <%= f.submit "Save & Continue", class: "btn-primary", style: "width: 100%; padding: 15px;" %>
    <% end %>

  <% else %>
    <div class="step-header">
      <h3>Step 2: Review Invoice</h3>
    </div>

    <div class="invoice-info-banner">
      <p><strong>📍 Shipping to:</strong><br>
      <%= current_user.address %>, <%= current_user.city %>, <%= current_user.province.name %></p>
    </div>

    <%# 订单明细表格略 - 建议加上简单的 class="table" %>

    <div class="price-summary">
      <div class="price-row"><span>Subtotal:</span> <span><%= number_to_currency(@subtotal) %></span></div>
      <div class="price-row"><span>GST (<%= (current_user.province.gst * 100).to_i %>%):</span> <span><%= number_to_currency(@gst) %></span></div>
      <div class="price-row"><span>PST (<%= (current_user.province.pst * 100).to_i %>%):</span> <span><%= number_to_currency(@pst) %></span></div>
      <div class="price-row"><span>HST (<%= (current_user.province.hst * 100).to_i %>%):</span> <span><%= number_to_currency(@hst) %></span></div>

      <div class="total-row">
        Total: <%= number_to_currency(@total) %>
      </div>

      <%= button_to "Confirm Order", checkout_path, method: :post, data: { turbo: false }, class: "btn-checkout", style: "width: 100%; margin-top: 20px; border: none;" %>
    </div>
  <% end %>
</div>