<h1><%= @product.name %></h1>

<!-- 显示大图 -->
<% if @product.image.attached? %>
  <%= image_tag @product.image, width: 300 %>
<% end %>

<p><%= @product.description %></p>

<p>Price: $<%= @product.price %></p>

<p>
  Categories:
  <% @product.categories.each do |category| %>
    <%# use link_to to generate a link to the category page %>
    <%= link_to category.name, category_path(category), class: "category-link" %>
  <% end %>
</p>
<form action="<%= add_to_cart_path(product_id: @product.id) %>" method="post">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
  <button type="submit" style="/* 这里可以加上你原来的 CSS */">Add to Cart</button>
</form>