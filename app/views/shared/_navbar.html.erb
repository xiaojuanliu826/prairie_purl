<nav class="main-navigation">
  <div class="nav-container">
    <div class="nav-brand">
      <%= link_to "Prairie Purl", root_path, class: "logo" %>
    </div>

    <div class="nav-links">
      <%# 类别循环 %>
      <% Category.all.each do |category| %>
        <%= link_to category.name, category_path(category) %>
      <% end %>

      <%# 过滤标签 %>
      <%= link_to "On Sale", products_path(filter: "on_sale"), class: "badge-sale" %>
      <%= link_to "New Arrivals", products_path(filter: "new") %>

      <%= link_to "About", about_path %>
      <%= link_to "Contact", contact_path %>
    </div>

    <div class="nav-user-actions">
      <%= link_to cart_path, class: "cart-link" do %>
        🛒 Cart
      <% end %>

      <% if user_signed_in? %>
        <span class="user-location">
          📍 <%= current_user.province&.name || "Not set" %>
        </span>
        <%= link_to "Orders", orders_path %>
        <%= link_to "Profile", edit_user_registration_path %>
        <%= link_to "Logout", destroy_user_session_path, data: { "turbo-method": :delete } %>
      <% else %>
        <%= link_to "Login", new_user_session_path %>
        <%= link_to "Sign Up", new_user_registration_path, class: "btn-signup" %>
      <% end %>
    </div>
  </div>
</nav>