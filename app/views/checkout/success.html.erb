<div class="container mt-5 text-center">
  <div class="card shadow p-5">
    <h1 class="text-success">🎉 Payment Successful!</h1>
    <p class="lead mt-3">Thank you for your purchase, <%= current_user.email %>!</p>

    <div class="alert alert-info mt-4">
      <strong>Order ID:</strong> #<%= @order.id %><br>
      <strong>Status:</strong> <span class="badge bg-success"><%= @order.status %></span><br>
      <strong>Total Paid:</strong> <%= number_to_currency(@order.total_amount) %>
    </div>

    <p class="text-muted">We have received your order for your handmade accessories and will begin processing it shortly.</p>

    <div class="mt-4">
      <%= link_to "Continue Shopping", root_path, class: "btn btn-primary" %>
      <%# 如果你有订单历史页面，可以连到那里 %>
      <%# <%= link_to "View My Orders", orders_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>
</div>