<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Prairie Purl" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <style>
    /* ---------------------------------
       1. 全局布局 (Global Layout)
       --------------------------------- */
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      margin: 0;
      background-color: #f7fafc;
      color: #2d3748;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
    }

    /* ---------------------------------
       2. 导航栏样式 (Navbar)
       --------------------------------- */
    .main-navigation {
      width: 100%;
      background: white;
      border-bottom: 1px solid #e2e8f0;
    }

    .nav-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 5%;
      flex-wrap: wrap;
    }

    .nav-brand .logo {
      font-size: 1.5rem;
      font-weight: bold;
      text-decoration: none;
      color: #2d3748;
    }

    .nav-links a, .nav-user-actions a {
      text-decoration: none;
      color: #4a5568;
      margin: 0 10px;
      font-weight: 500;
      transition: color 0.2s;
    }

    .nav-links a:hover { color: #3182ce; }

    .badge-sale { color: #e53e3e !important; font-weight: bold; }

    .user-location { color: #718096; font-size: 0.85rem; margin-right: 10px; }

    /* ---------------------------------
       3. 响应式设计 (Responsive)
       --------------------------------- */
    @media (max-width: 768px) {
      .nav-container {
        flex-direction: column;
        padding: 1rem;
      }
      .nav-links, .nav-user-actions {
        margin-top: 15px;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
      }
      .nav-links a, .nav-user-actions a {
        margin: 5px;
      }
    }
  </style>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "shared/navbar" %>

    <main class="container">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>


  </body>
</html>