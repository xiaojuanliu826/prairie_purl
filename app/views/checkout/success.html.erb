<div class="checkout-box success-card">
  <div class="success-icon">🎉</div>
  <h1 style="color: #28a745;">Payment Successful!</h1>
  <p class="lead">Thank you for your purchase, <strong><%= current_user.email %></strong>!</p>

  <div class="invoice-info-banner" style="text-align: left; margin-top: 2rem;">
    <p><strong>Order ID:</strong> #<%= @order.id %></p>
    <p><strong>Status:</strong> <span class="badge-sale" style="background: #c6f6d5; padding: 4px 8px; border-radius: 4px;">Paid</span></p>
    <p><strong>Total Paid:</strong> <%= number_to_currency(@order.total_amount) %></p>
  </div>

  <p style="color: #718096; font-size: 0.9rem;">We have received your order and will begin processing it shortly.</p>

  <div style="margin-top: 2rem; display: flex; gap: 15px; justify-content: center;">
    <%= link_to "Continue Shopping", root_path, class: "btn-primary", style: "text-decoration: none;" %>
    <%= link_to "My Orders", orders_path, class: "back-link", style: "padding: 10px;" %>
  </div>
</div>