<div class="products-header">
  <h1 class="page-title">Products</h1>

  <%# 🔍 搜索表单区域 %>
  <div class="search-section">
    <%= form_with url: products_path, method: :get, local: true, class: "filter-form" do %>
      <div class="filter-group">
        <%= label_tag :keyword, "Keyword", class: "sr-only" %>
        <%= text_field_tag :keyword, params[:keyword], placeholder: "Search products..." %>
      </div>

      <div class="filter-group">
        <%= label_tag :category_id, "Category", class: "sr-only" %>
        <%= select_tag :category_id,
            options_from_collection_for_select(
              @categories,
              :id,
              :name,
              params[:category_id]
            ),
            include_blank: "All Categories"
        %>
      </div>

      <div class="filter-actions">
        <%= submit_tag "Search", class: "btn-search" %>
      </div>
    <% end %>
  </div>
</div>

<hr class="section-divider">

<%# 📦 产品展示区域 %>
<div class="product-grid">
  <%# 依然使用你原本的逻辑，但包装在类名中 %>
  <% @products.each do |product| %>
    <%= render partial: 'product_card', locals: { product: product } %>
  <% end %>
</div>

<div class="pagination-footer">
  <%= paginate @products %>
</div>