<h1 class="page-title">Your Shopping Cart</h1>

<div class="cart-container">
  <% if @products.any? %>
    <div class="cart-items">
      <% @products.each do |product| %>
        <div class="cart-item">
          <div class="item-info">
            <h2 class="item-name"><%= product.name %></h2>
            <p class="item-price">Unit Price: <%= number_to_currency(product.price) %></p>
          </div>

          <div class="item-actions">
            <%# 更新数量表单 %>
            <%= form_with url: update_cart_path(product), method: :patch, class: "update-qty-form" do %>
              <div class="qty-control">
                <%= label_tag "quantity_#{product.id}", "Qty:", class: "sr-only" %>
                <%= number_field_tag :quantity, session[:cart][product.id.to_s],
                    min: 1, id: "quantity_#{product.id}", class: "qty-input" %>
                <%= submit_tag "Update", class: "btn-update" %>
              </div>
            <% end %>

            <%# 删除按钮 %>
            <%= button_to remove_cart_path(product), method: :delete,
                form: { data: { turbo_confirm: 'Are you sure?' } },
                class: "btn-remove" do %>
              Delete
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="cart-summary">
      <div class="summary-details">
        <p class="total-label">Subtotal:</p>
        <p class="total-amount">
          <%= number_to_currency(@products.sum { |p| p.price * session[:cart][p.id.to_s].to_i }) %>
        </p>
      </div>

      <div class="summary-actions">
        <%= link_to "Continue Shopping", products_path, class: "link-continue" %>
        <%= link_to "Proceed to Checkout", checkout_path, class: "btn-checkout" %>
      </div>
    </div>

  <% else %>
    <div class="empty-state">
      <p>Your cart is empty.</p>
      <%= link_to "Go shopping!", products_path, class: "btn-primary" %>
    </div>
  <% end %>
</div>