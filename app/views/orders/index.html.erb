<h1 class="page-title">My Order History</h1>

<div class="orders-container">
  <% if @orders.any? %>
    <div class="orders-list">
      <% @orders.each do |order| %>
        <div class="order-card">
          <div class="order-meta">
            <span class="order-number">Order #<%= order.id %></span>
            <span class="order-date"><%= order.created_at.strftime("%b %d, %Y") %></span>
          </div>

          <div class="order-status-group">
            <span class="status-badge <%= order.status.downcase %>">
              <%= order.status.capitalize %>
            </span>
          </div>

          <div class="order-total">
            <span class="total-label">Total Amount:</span>
            <span class="total-value"><%= number_to_currency(order.total_amount) %></span>
          </div>

          <div class="order-actions">
            <%= link_to "View Order Details", order_path(order), class: "btn-view-details" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <p>You haven't placed any orders yet.</p>
      <%= link_to "Start Shopping", root_path, class: "btn-primary" %>
    </div>
  <% end %>
</div>